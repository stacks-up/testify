# Password policy for make-password-profile.sh.
#
# Copy this file to password-policy.conf and set your organisation's values.
# password-policy.conf is git-ignored, so your real policy stays out of the
# repository. The values below are placeholders, not a recommendation.

# Shown in System Settings > General > Device Management.
ORGANISATION="Example Org"
DESCRIPTION="Minimum 12-character login password with letters and numbers."

# Minimum password length.
MIN_LENGTH=12

# Require at least one letter and one number (true/false).
REQUIRE_ALPHANUMERIC=true

# Minimum number of non-alphanumeric characters (0 = none required).
MIN_COMPLEX_CHARS=0

# Allow simple passwords such as repeated or sequential characters (true/false).
ALLOW_SIMPLE=false

# Failed attempts before macOS starts imposing login delays.
MAX_FAILED_ATTEMPTS=10

# Days before the password must be changed (0 = never expires).
MAX_PIN_AGE_DAYS=0
